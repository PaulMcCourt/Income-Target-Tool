      <column caption='HideKPI' datatype='boolean' name='[Calculation_0358478574854154]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 4]&lt;&gt;&quot;&quot;&#13;&#10;and [Parameters].[Parameter 5]&lt;&gt;&quot;&quot;&#13;&#10;and [Parameters].[Parameter 2]&lt;&gt;&quot;&quot;&#13;&#10;and [Parameters].[Parameter 3]&lt;&gt;&quot;&quot;&#13;&#10;&#13;&#10;&#13;&#10;//Used to hide the KPI until all the inital fields are filled out' />
