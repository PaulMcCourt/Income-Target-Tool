      <column caption='StateCountyParamToggle' datatype='string' name='[Calculation_0322742711754757]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 6]=&quot;State&quot; then &quot;County&quot;&#13;&#10;elseif [Parameters].[Parameter 6]=&quot;County&quot; Then &quot;State&quot;&#13;&#10;elseif [Parameters].[Parameter 6]=&quot;Neither&quot; then &quot;State&quot;&#13;&#10;END' />
      </column>
      <column caption='BacktoStateView' datatype='string' name='[Calculation_0322742713782278]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 6]=&quot;County&quot; then &quot;← Back to State View&quot;&#13;&#10;END' />
      </column>
