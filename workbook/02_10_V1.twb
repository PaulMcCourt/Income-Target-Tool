      <table>
        <view>
          <datasources>
            <datasource caption='County (fbc_data_2025_cleaned)' name='federated.1no5xvs0wkzfmg1b0wvnm18gq359' />
          </datasources>
          <datasource-dependencies datasource='federated.1no5xvs0wkzfmg1b0wvnm18gq359'>
            <column caption='NumberOfParents' datatype='string' name='[Calculation_0982993814982656]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Family]&#13;&#10;when &apos;1p0c&apos; then &apos;One parent&apos;&#13;&#10;when &apos;1p1c&apos; then &apos;One parent&apos;&#13;&#10;when &apos;1p2c&apos; then &apos;One parent&apos;&#13;&#10;when &apos;1p3c&apos; then &apos;One parent&apos;&#13;&#10;when &apos;1p4c&apos; then &apos;One parent&apos;&#13;&#10;when &apos;2p0c&apos; then &apos;Two parents&apos;&#13;&#10;when &apos;2p1c&apos; then &apos;Two parents&apos;&#13;&#10;when &apos;2p2c&apos; then &apos;Two parents&apos;&#13;&#10;when &apos;2p3c&apos; then &apos;Two parents&apos;&#13;&#10;when &apos;2p4c&apos; then &apos;Two parents&apos;&#13;&#10;else &apos;N/A&apos;&#13;&#10;END' />
              <aliases>
                <alias key='&quot;married&quot;' value='2 parents' />
                <alias key='&quot;single&quot;' value='1 parent' />
              </aliases>
            </column>
            <column caption='sum(1)' datatype='integer' name='[Calculation_0982994078584838]' role='measure' type='quantitative' user:unnamed='MaritalStatus'>
              <calculation class='tableau' formula='sum(1)' />
