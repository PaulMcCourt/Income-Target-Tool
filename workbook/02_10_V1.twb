      <aliases enabled='yes' />
      <column caption='PieChartDupField' datatype='integer' name='[Calculation_0204269207531521]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='1' />
      </column>
      <column caption='KPI State Average AnnualMonthly Total Income' datatype='real' name='[Calculation_0231482194718721]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Name: KPI - State Annual Total&#13;&#10;{FIXED [State abv.], [Family] : AVG(&#13;&#10;    IF [Family] = [Calculation_0982994084581384]&#13;&#10;and [Pivot Field Names] = ([Parameters].[Parameter 1]+ &apos; Total&apos;) // Dynamically looks at either monthly or annual totals based on param&#13;&#10;THEN [Pivot Field Values] END&#13;&#10;)}' />
      </column>
      <column caption='SelectedStateWrapper' datatype='string' name='[Calculation_0231482200649730]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 4]&#13;&#10;    WHEN &apos;AL&apos; THEN &apos;Alabama&apos;&#13;&#10;    WHEN &apos;AK&apos; THEN &apos;Alaska&apos;&#13;&#10;    WHEN &apos;AZ&apos; THEN &apos;Arizona&apos;&#13;&#10;    WHEN &apos;AR&apos; THEN &apos;Arkansas&apos;&#13;&#10;    WHEN &apos;CA&apos; THEN &apos;California&apos;&#13;&#10;    WHEN &apos;CO&apos; THEN &apos;Colorado&apos;&#13;&#10;    WHEN &apos;CT&apos; THEN &apos;Connecticut&apos;&#13;&#10;    WHEN &apos;DE&apos; THEN &apos;Delaware&apos;&#13;&#10;    WHEN &apos;DC&apos; THEN &apos;District of Columbia&apos;&#13;&#10;    WHEN &apos;FL&apos; THEN &apos;Florida&apos;&#13;&#10;    WHEN &apos;GA&apos; THEN &apos;Georgia&apos;&#13;&#10;    WHEN &apos;HI&apos; THEN &apos;Hawaii&apos;&#13;&#10;    WHEN &apos;ID&apos; THEN &apos;Idaho&apos;&#13;&#10;    WHEN &apos;IL&apos; THEN &apos;Illinois&apos;&#13;&#10;    WHEN &apos;IN&apos; THEN &apos;Indiana&apos;&#13;&#10;    WHEN &apos;IA&apos; THEN &apos;Iowa&apos;&#13;&#10;    WHEN &apos;KS&apos; THEN &apos;Kansas&apos;&#13;&#10;    WHEN &apos;KY&apos; THEN &apos;Kentucky&apos;&#13;&#10;    WHEN &apos;LA&apos; THEN &apos;Louisiana&apos;&#13;&#10;    WHEN &apos;ME&apos; THEN &apos;Maine&apos;&#13;&#10;    WHEN &apos;MD&apos; THEN &apos;Maryland&apos;&#13;&#10;    WHEN &apos;MA&apos; THEN &apos;Massachusetts&apos;&#13;&#10;    WHEN &apos;MI&apos; THEN &apos;Michigan&apos;&#13;&#10;    WHEN &apos;MN&apos; THEN &apos;Minnesota&apos;&#13;&#10;    WHEN &apos;MS&apos; THEN &apos;Mississippi&apos;&#13;&#10;    WHEN &apos;MO&apos; THEN &apos;Missouri&apos;&#13;&#10;    WHEN &apos;MT&apos; THEN &apos;Montana&apos;&#13;&#10;    WHEN &apos;NE&apos; THEN &apos;Nebraska&apos;&#13;&#10;    WHEN &apos;NV&apos; THEN &apos;Nevada&apos;&#13;&#10;    WHEN &apos;NH&apos; THEN &apos;New Hampshire&apos;&#13;&#10;    WHEN &apos;NJ&apos; THEN &apos;New Jersey&apos;&#13;&#10;    WHEN &apos;NM&apos; THEN &apos;New Mexico&apos;&#13;&#10;    WHEN &apos;NY&apos; THEN &apos;New York&apos;&#13;&#10;    WHEN &apos;NC&apos; THEN &apos;North Carolina&apos;&#13;&#10;    WHEN &apos;ND&apos; THEN &apos;North Dakota&apos;&#13;&#10;    WHEN &apos;OH&apos; THEN &apos;Ohio&apos;&#13;&#10;    WHEN &apos;OK&apos; THEN &apos;Oklahoma&apos;&#13;&#10;    WHEN &apos;OR&apos; THEN &apos;Oregon&apos;&#13;&#10;    WHEN &apos;PA&apos; THEN &apos;Pennsylvania&apos;&#13;&#10;    WHEN &apos;RI&apos; THEN &apos;Rhode Island&apos;&#13;&#10;    WHEN &apos;SC&apos; THEN &apos;South Carolina&apos;&#13;&#10;    WHEN &apos;SD&apos; THEN &apos;South Dakota&apos;&#13;&#10;    WHEN &apos;TN&apos; THEN &apos;Tennessee&apos;&#13;&#10;    WHEN &apos;TX&apos; THEN &apos;Texas&apos;&#13;&#10;    WHEN &apos;UT&apos; THEN &apos;Utah&apos;&#13;&#10;    WHEN &apos;VT&apos; THEN &apos;Vermont&apos;&#13;&#10;    WHEN &apos;VA&apos; THEN &apos;Virginia&apos;&#13;&#10;    WHEN &apos;WA&apos; THEN &apos;Washington&apos;&#13;&#10;    WHEN &apos;WV&apos; THEN &apos;West Virginia&apos;&#13;&#10;    WHEN &apos;WI&apos; THEN &apos;Wisconsin&apos;&#13;&#10;    WHEN &apos;WY&apos; THEN &apos;Wyoming&apos;&#13;&#10;    ELSE [Parameters].[Parameter 4]&#13;&#10;END' />
      </column>
      <column caption='MonthlyAnnuallyFilter' datatype='boolean' name='[Calculation_0231482207072260]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1709775317762054]=[Parameters].[Parameter 1] &#13;&#10;and [Pivot Field Names]&lt;&gt; &quot;Annual Total&quot; &#13;&#10;and [Pivot Field Names] &lt;&gt;&quot;Monthly Total&quot;&#13;&#10;&#13;&#10;// Filters the columns based on the parameter selection' />
      </column>
      <column caption='FilterSelectedState' datatype='boolean' name='[Calculation_0274363826266112]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[State abv.]=[Parameters].[Parameter 4]' />
      </column>
      <column caption='KPI County Required Total Income' datatype='real' name='[Calculation_0274363829235714]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [State abv.], [County] :&#13;&#10;    AVG(&#13;&#10;        IF [Family] = [Calculation_0982994084581384]&#13;&#10;        AND [Pivot Field Names] = ([Parameters].[Parameter 1] + &apos; Total&apos;)&#13;&#10;        THEN [Pivot Field Values]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
      </column>
      <column caption='SelectedCountyParameterWrapper' datatype='string' name='[Calculation_0274363835047939]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 5]' />
      </column>
      <column caption='ColorSelectedCounty' datatype='string' name='[Calculation_0274363836289028]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [County] = [Parameters].[Parameter 5]&#13;&#10;THEN &quot;Selected&quot;&#13;&#10;ELSE &quot;Not Selected&quot;&#13;&#10;END' />
      </column>
      <column caption='SelectedCountyLabel' datatype='real' name='[Calculation_0274363841880071]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [County]=[Parameters].[Parameter 5] &#13;&#10;then [Calculation_0274363829235714]&#13;&#10;else null&#13;&#10;end' />
      </column>
      <column caption='County Difference against State average' datatype='real' name='[Calculation_0274363857997832]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0274363829235714]-[Calculation_0231482194718721]' />
      </column>
      <column caption='ShowStateView' datatype='boolean' name='[Calculation_0322742707232772]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 6]=&quot;State&quot;&#13;&#10;&#13;&#10;//This needs to also be based on the value of StateCountyView parameter I want to use this for visibility for bothe county and state selector&#13;&#10;&#13;&#10;//1 User opens dashboard&#13;&#10;//2 all states are visible until one is selected&#13;&#10;//3 When a state is selected, filter out the other states using &#13;&#10;//[SelectedState]=&apos;&apos;&#13;&#10;//' />
      </column>
      <column caption='StateCountyViewHelperField' datatype='string' name='[Calculation_0322742711754757]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 6]=&quot;State&quot; then &quot;County&quot;&#13;&#10;else &quot;State&quot;&#13;&#10;END' />
      </column>
      <column caption='BacktoStateView' datatype='string' name='[Calculation_0322742713782278]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Parameters].[Parameter 6]=&quot;County&quot; then &quot;← Back to State View&quot;&#13;&#10;END' />
      </column>
      <column caption='ShowCountyView' datatype='boolean' name='[Calculation_0322742718689287]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 6]=&quot;County&quot;' />
      </column>
      <column caption='NumberOfParents' datatype='string' name='[Calculation_0982993814982656]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Family]&#13;&#10;when &apos;1p0c&apos; then &apos;One parent&apos;&#13;&#10;when &apos;1p1c&apos; then &apos;One parent&apos;&#13;&#10;when &apos;1p2c&apos; then &apos;One parent&apos;&#13;&#10;when &apos;1p3c&apos; then &apos;One parent&apos;&#13;&#10;when &apos;1p4c&apos; then &apos;One parent&apos;&#13;&#10;when &apos;2p0c&apos; then &apos;Two parents&apos;&#13;&#10;when &apos;2p1c&apos; then &apos;Two parents&apos;&#13;&#10;when &apos;2p2c&apos; then &apos;Two parents&apos;&#13;&#10;when &apos;2p3c&apos; then &apos;Two parents&apos;&#13;&#10;when &apos;2p4c&apos; then &apos;Two parents&apos;&#13;&#10;else &apos;N/A&apos;&#13;&#10;END' />
        <aliases>
          <alias key='&quot;married&quot;' value='2 parents' />
          <alias key='&quot;single&quot;' value='1 parent' />
        </aliases>
      </column>
      <column caption='ChildrenCount' datatype='string' name='[Calculation_0982994065620993]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='case [Family]&#13;&#10;when &apos;1p0c&apos; then &apos;0&apos;&#13;&#10;when &apos;1p1c&apos; then &apos;1&apos;&#13;&#10;when &apos;1p2c&apos; then &apos;2&apos;&#13;&#10;when &apos;1p3c&apos; then &apos;3&apos;&#13;&#10;when &apos;1p4c&apos; then &apos;4&apos;&#13;&#10;when &apos;2p0c&apos; then &apos;0&apos;&#13;&#10;when &apos;2p1c&apos; then &apos;1&apos;&#13;&#10;when &apos;2p2c&apos; then &apos;2&apos;&#13;&#10;when &apos;2p3c&apos; then &apos;3&apos;&#13;&#10;when &apos;2p4c&apos; then &apos;4&apos;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='ChildrenCountParameter' datatype='string' name='[Calculation_0982994069602306]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Parameters].[Parameter 3]' />
      </column>
      <column caption='MaritalStatusChildrenCountRecombined' datatype='string' name='[Calculation_0982994084581384]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//After the single and children count selectors are chosen, return the original data value&#13;&#10;&#13;&#10;IF [Parameters].[Parameter 2] = &apos;One parent&apos;&#13;&#10;AND [Parameters].[Parameter 3] = &apos;0&apos;&#13;&#10;THEN &apos;1p0c&apos;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;One parent&apos;&#13;&#10;AND [Parameters].[Parameter 3] = &apos;1&apos;&#13;&#10;THEN &apos;1p1c&apos;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;One parent&apos;&#13;&#10;AND [Parameters].[Parameter 3] = &apos;2&apos;&#13;&#10;THEN &apos;1p2c&apos;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;One parent&apos;&#13;&#10;AND [Parameters].[Parameter 3] = &apos;3&apos;&#13;&#10;THEN &apos;1p3c&apos;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;One parent&apos;&#13;&#10;AND [Parameters].[Parameter 3] = &apos;4&apos;&#13;&#10;THEN &apos;1p4c&apos;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Two parents&apos;&#13;&#10;AND [Parameters].[Parameter 3] = &apos;0&apos;&#13;&#10;THEN &apos;2p0c&apos;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Two parents&apos;&#13;&#10;AND [Parameters].[Parameter 3] = &apos;1&apos;&#13;&#10;THEN &apos;2p1c&apos;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Two parents&apos;&#13;&#10;AND [Parameters].[Parameter 3] = &apos;2&apos;&#13;&#10;THEN &apos;2p2c&apos;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Two parents&apos;&#13;&#10;AND [Parameters].[Parameter 3] = &apos;3&apos;&#13;&#10;THEN &apos;2p3c&apos;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Two parents&apos;&#13;&#10;AND [Parameters].[Parameter 3] = &apos;4&apos;&#13;&#10;THEN &apos;2p4c&apos;&#13;&#10;ELSE &apos;N/A&apos;&#13;&#10;END' />
      </column>
      <column caption='MatchesSelection' datatype='boolean' name='[Calculation_0982994097074187]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='//Dynamically filters based on the values of a parameter&#13;&#10;&#13;&#10;[State abv.] = [Parameters].[Parameter 4]   // from map selector&#13;&#10;AND&#13;&#10;[Calculation_0982993814982656] = [Parameters].[Parameter 2]   // from marital bar&#13;&#10;AND&#13;&#10;[Calculation_0982994065620993] = [Parameters].[Parameter 3]  // from children bar' />
      </column>
      <column caption='MonthlyAnnually' datatype='string' name='[Calculation_1709775317762054]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([Pivot Field Names], &quot;Annual&quot;) THEN &quot;Annual&quot;&#13;&#10;ELSE &quot;Monthly&quot;&#13;&#10;END' />
      </column>
      <column caption='Expense Type' datatype='string' name='[Calculation_1709775318007815]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='REPLACE(&#13;&#10;    REPLACE([Pivot Field Names], &quot;Annual &quot;, &quot;&quot;),&#13;&#10;    &quot;Monthly &quot;, &quot;&quot;&#13;&#10;)' />
      </column>
      <column caption='Selected Annual Average Total Expenses' datatype='real' name='[Calculation_1709775320436745]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [State abv.] = [Parameters].[Parameter 4]&#13;&#10;AND [Calculation_0982993814982656] = [Parameters].[Parameter 2]&#13;&#10;AND [Calculation_0982994065620993] = [Parameters].[Parameter 3]&#13;&#10;AND [Calculation_1709775317762054] = &quot;Annual&quot;&#13;&#10;And [Pivot Field Names] = &quot;Annual Total&quot;&#13;&#10;THEN [Pivot Field Values]&#13;&#10;END' />
      </column>
