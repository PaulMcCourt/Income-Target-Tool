    <worksheet name='DonutChartBreakdown'>
      <table>
        <view>
          <datasources>
            <datasource caption='County (fbc_data_2025_cleaned)' name='federated.1no5xvs0wkzfmg1b0wvnm18gq359' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='TimeFrame' datatype='string' name='[Parameter 1]' param-domain-type='list' role='measure' type='nominal' value='&quot;Annual&quot;'>
              <calculation class='tableau' formula='&quot;Annual&quot;' />
            </column>
            <column caption='NumberOfParents' datatype='string' name='[Parameter 2]' param-domain-type='any' role='measure' type='nominal' value='&quot;One parent&quot;'>
              <calculation class='tableau' formula='&quot;One parent&quot;' />
            </column>
            <column caption='ChildrenCount' datatype='string' name='[Parameter 3]' param-domain-type='any' role='measure' type='nominal' value='&quot;0&quot;'>
              <calculation class='tableau' formula='&quot;0&quot;' />
            </column>
            <column caption='SelectedState' datatype='string' name='[Parameter 4]' param-domain-type='any' role='measure' type='nominal' value='&quot;ID&quot;'>
              <calculation class='tableau' formula='&quot;ID&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1no5xvs0wkzfmg1b0wvnm18gq359'>
            <column caption='PieChartDupField' datatype='integer' name='[Calculation_0204269207531521]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='1' />
            </column>
            <column caption='KPI State Average AnnualMonthly Total Income' datatype='real' name='[Calculation_0231482194718721]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='// Name: KPI - State Annual Total&#13;&#10;{FIXED [State abv.], [Family] : AVG(&#13;&#10;    IF [Family] = [Calculation_0982994084581384]&#13;&#10;and [Pivot Field Names] = ([Parameters].[Parameter 1]+ &apos; Total&apos;) // Dynamically looks at either monthly or annual totals based on param&#13;&#10;THEN [Pivot Field Values] END&#13;&#10;)}' />
            </column>
            <column caption='MonthlyAnnuallyFilter' datatype='boolean' name='[Calculation_0231482207072260]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_1709775317762054]=[Parameters].[Parameter 1] &#13;&#10;and [Pivot Field Names]&lt;&gt; &quot;Annual Total&quot; &#13;&#10;and [Pivot Field Names] &lt;&gt;&quot;Monthly Total&quot;&#13;&#10;&#13;&#10;// Filters the columns based on the parameter selection' />
            </column>
            <column caption='NumberOfParentsParamWrapper' datatype='string' name='[Calculation_0982993814982656]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='CASE [Family]&#13;&#10;when &apos;1p0c&apos; then &apos;One parent&apos;&#13;&#10;when &apos;1p1c&apos; then &apos;One parent&apos;&#13;&#10;when &apos;1p2c&apos; then &apos;One parent&apos;&#13;&#10;when &apos;1p3c&apos; then &apos;One parent&apos;&#13;&#10;when &apos;1p4c&apos; then &apos;One parent&apos;&#13;&#10;when &apos;2p0c&apos; then &apos;Two parents&apos;&#13;&#10;when &apos;2p1c&apos; then &apos;Two parents&apos;&#13;&#10;when &apos;2p2c&apos; then &apos;Two parents&apos;&#13;&#10;when &apos;2p3c&apos; then &apos;Two parents&apos;&#13;&#10;when &apos;2p4c&apos; then &apos;Two parents&apos;&#13;&#10;else &apos;N/A&apos;&#13;&#10;END' />
              <aliases>
                <alias key='&quot;married&quot;' value='2 parents' />
                <alias key='&quot;single&quot;' value='1 parent' />
              </aliases>
            </column>
            <column caption='ChildrenCountParsed' datatype='string' name='[Calculation_0982994065620993]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='case [Family]&#13;&#10;when &apos;1p0c&apos; then &apos;0&apos;&#13;&#10;when &apos;1p1c&apos; then &apos;1&apos;&#13;&#10;when &apos;1p2c&apos; then &apos;2&apos;&#13;&#10;when &apos;1p3c&apos; then &apos;3&apos;&#13;&#10;when &apos;1p4c&apos; then &apos;4&apos;&#13;&#10;when &apos;2p0c&apos; then &apos;0&apos;&#13;&#10;when &apos;2p1c&apos; then &apos;1&apos;&#13;&#10;when &apos;2p2c&apos; then &apos;2&apos;&#13;&#10;when &apos;2p3c&apos; then &apos;3&apos;&#13;&#10;when &apos;2p4c&apos; then &apos;4&apos;&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='MaritalStatusChildrenCountRecombined' datatype='string' name='[Calculation_0982994084581384]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//After the single and children count selectors are chosen, return the original data value&#13;&#10;&#13;&#10;IF [Parameters].[Parameter 2] = &apos;One parent&apos;&#13;&#10;AND [Parameters].[Parameter 3] = &apos;0&apos;&#13;&#10;THEN &apos;1p0c&apos;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;One parent&apos;&#13;&#10;AND [Parameters].[Parameter 3] = &apos;1&apos;&#13;&#10;THEN &apos;1p1c&apos;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;One parent&apos;&#13;&#10;AND [Parameters].[Parameter 3] = &apos;2&apos;&#13;&#10;THEN &apos;1p2c&apos;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;One parent&apos;&#13;&#10;AND [Parameters].[Parameter 3] = &apos;3&apos;&#13;&#10;THEN &apos;1p3c&apos;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;One parent&apos;&#13;&#10;AND [Parameters].[Parameter 3] = &apos;4&apos;&#13;&#10;THEN &apos;1p4c&apos;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Two parents&apos;&#13;&#10;AND [Parameters].[Parameter 3] = &apos;0&apos;&#13;&#10;THEN &apos;2p0c&apos;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Two parents&apos;&#13;&#10;AND [Parameters].[Parameter 3] = &apos;1&apos;&#13;&#10;THEN &apos;2p1c&apos;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Two parents&apos;&#13;&#10;AND [Parameters].[Parameter 3] = &apos;2&apos;&#13;&#10;THEN &apos;2p2c&apos;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Two parents&apos;&#13;&#10;AND [Parameters].[Parameter 3] = &apos;3&apos;&#13;&#10;THEN &apos;2p3c&apos;&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &apos;Two parents&apos;&#13;&#10;AND [Parameters].[Parameter 3] = &apos;4&apos;&#13;&#10;THEN &apos;2p4c&apos;&#13;&#10;ELSE &apos;N/A&apos;&#13;&#10;END' />
            </column>
            <column caption='MatchesSelection' datatype='boolean' name='[Calculation_0982994097074187]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='//Dynamically filters based on the values of a parameter&#13;&#10;&#13;&#10;[State abv.] = [Parameters].[Parameter 4]   // from map selector&#13;&#10;AND&#13;&#10;[Calculation_0982993814982656] = [Parameters].[Parameter 2]   // from marital bar&#13;&#10;AND&#13;&#10;[Calculation_0982994065620993] = [Parameters].[Parameter 3]  // from children bar' />
            </column>
            <column caption='MonthlyAnnually' datatype='string' name='[Calculation_1709775317762054]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF CONTAINS([Pivot Field Names], &quot;Annual&quot;) THEN &quot;Annual&quot;&#13;&#10;ELSE &quot;Monthly&quot;&#13;&#10;END' />
            </column>
            <column datatype='string' name='[Family]' role='dimension' type='nominal' />
            <column datatype='string' name='[Pivot Field Names]' role='dimension' type='nominal' />
            <column caption='Pivoted Expense Amounts' datatype='real' name='[Pivot Field Values]' role='measure' type='quantitative' />
            <column datatype='string' name='[State abv.]' role='dimension' semantic-role='[State].[Name]' type='nominal'>
              <aliases>
                <alias key='&quot;OR&quot;' value='Oregon' />
              </aliases>
            </column>
            <column-instance column='[Calculation_0231482194718721]' derivation='Avg' name='[avg:Calculation_0231482194718721:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Pivot Field Values]' derivation='Avg' name='[avg:Pivot Field Values:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0204269207531521]' derivation='Min' name='[min:Calculation_0204269207531521:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0231482207072260]' derivation='None' name='[none:Calculation_0231482207072260:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0982994097074187]' derivation='None' name='[none:Calculation_0982994097074187:nk]' pivot='key' type='nominal' />
            <column-instance column='[Pivot Field Names]' derivation='None' name='[none:Pivot Field Names:nk]' pivot='key' type='nominal' />
            <column-instance column='[Pivot Field Values]' derivation='Sum' name='[pcto:sum:Pivot Field Values:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' type='PctTotal' />
            </column-instance>
