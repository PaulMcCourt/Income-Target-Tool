            <groupfilter function='member' level='[none:Calculation_0231482207072260:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.1no5xvs0wkzfmg1b0wvnm18gq359].[none:Calculation_0982994097074187:nk]'>
