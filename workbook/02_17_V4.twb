              <calculation class='tableau' formula='IF [Family] = [Calculation_0982994084581384]&#13;&#10;AND [Pivot Field Names] = &apos;Annual Total&apos;&#13;&#10;and [State abv.]=[Parameters].[Parameter 4]&#13;&#10;and [County]=[Parameters].[Parameter 5]&#13;&#10;THEN [Pivot Field Values]&#13;&#10;END' />
